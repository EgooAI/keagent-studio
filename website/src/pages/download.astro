---
import BaseLayout from "../layouts/BaseLayout.astro";
import { releaseDownloads, hasAnyDownloadUrl } from "../config/downloads";
import { siteConfig, hasContactConfigured } from "../config/site";

const anyDownloadReady = hasAnyDownloadUrl();
const showContact = hasContactConfigured();
---

<BaseLayout
  title="下载中心"
  description="下载 AI来客 Windows 与 macOS 桌面客户端。内置 FFmpeg 与本机执行环境，安装即可使用。"
>
  <!-- Header Banner -->
  <section class="border-b border-line bg-arch-grid">
    <div class="bg-gradient-to-b from-white/60 via-white/85 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <div class="max-w-3xl">
          <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-brand-border bg-brand-soft px-3 py-1 text-xs font-medium text-brand">
            <span>桌面客户端下载</span>
            <span class="text-brand/40">|</span>
            <span class="tabular-nums">当前基线 v{releaseDownloads.version} {releaseDownloads.channel}</span>
            <span class="text-brand/40">|</span>
            <span>{releaseDownloads.releaseDate}</span>
          </div>

          <h1 class="mt-4 text-3xl font-bold tracking-tight text-ink-strong sm:text-4xl">
            获取 AI来客 桌面客户端
          </h1>
          <p class="mt-3 text-base leading-relaxed text-muted">
            {releaseDownloads.summary}
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            {
              releaseDownloads.bundledRuntimeNotes.map((note) => (
                <span class="inline-flex items-center rounded-lg border border-line bg-white px-3 py-1.5 text-xs text-ink">
                  ✓ {note}
                </span>
              ))
            }
          </div>
        </div>

        {
          !anyDownloadReady && (
            <div class="mt-8 rounded-2xl border border-amber-300/70 bg-amber-soft/75 p-5">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <div class="text-sm font-semibold text-amber-ink">
                    公开下载通道正在准备中
                  </div>
                  <p class="mt-1 text-xs leading-relaxed text-amber-ink/90">
                    Windows 与 macOS 安装包分发链接即将上线。内测阶段账号由管理员统一开通，您可先查阅使用帮助了解完整流程，待分发链接配置后即可在此直接下载。
                  </p>
                </div>
                <a
                  href="/docs/getting-started"
                  class="inline-flex shrink-0 items-center justify-center rounded-lg border border-amber-400/60 bg-white px-4 py-2 text-xs font-semibold text-amber-ink transition-colors hover:bg-amber-50"
                >
                  先看快速上手 →
                </a>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Platform Cards -->
  <section class="border-b border-line bg-canvas/55 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-3">
        {
          releaseDownloads.packages.map((pkg) => {
            const hasUrl = Boolean(pkg.url.trim());
            return (
              <div
                class:list={[
                  "flex flex-col justify-between rounded-2xl border bg-white p-6",
                  pkg.recommended ? "border-brand shadow-[0_0_0_1px_rgba(114,46,209,0.2)]" : "border-line",
                ]}
              >
                <div>
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h2 class="text-lg font-bold text-ink-strong">{pkg.name}</h2>
                      <div class="mt-1 flex items-center gap-2 text-xs text-muted">
                        <span>{pkg.archLabel}</span>
                        <span>·</span>
                        <span class="font-mono">{pkg.format}</span>
                      </div>
                    </div>
                    {pkg.recommended && (
                      <span class="rounded-md bg-brand-soft px-2.5 py-1 text-xs font-semibold text-brand">
                        常用
                      </span>
                    )}
                  </div>

                  <div class="mt-5 space-y-2 rounded-xl border border-line bg-soft p-3.5 text-xs">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-muted">系统要求</span>
                      <span class="font-medium text-ink">{pkg.minOs}</span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-muted">安装包名</span>
                      <span class="truncate font-mono text-[11px] text-ink" title={pkg.filename}>
                        {pkg.filename}
                      </span>
                    </div>
                    {pkg.size && (
                      <div class="flex items-center justify-between gap-2">
                        <span class="text-muted">文件大小</span>
                        <span class="tabular-nums font-medium text-ink">{pkg.size}</span>
                      </div>
                    )}
                  </div>

                  <ul class="mt-5 space-y-2 text-xs leading-relaxed text-ink">
                    {pkg.highlights.map((item) => (
                      <li class="flex items-start gap-2">
                        <span class="mt-0.5 text-brand">•</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-6 border-t border-line pt-5">
                  {hasUrl ? (
                    <a
                      href={pkg.url}
                      class="inline-flex h-10 w-full items-center justify-center rounded-xl bg-brand px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-hover active:bg-brand-active"
                    >
                      下载 {pkg.name}
                    </a>
                  ) : (
                    <button
                      type="button"
                      disabled
                      class="inline-flex h-10 w-full cursor-not-allowed items-center justify-center rounded-xl border border-control bg-canvas px-4 text-sm font-medium text-muted"
                    >
                      下载链接即将开放
                    </button>
                  )}

                  {pkg.sha256 && (
                    <div class="mt-3 rounded-lg bg-soft px-2.5 py-2 text-[11px] text-muted">
                      <div class="font-medium text-ink">SHA-256 校验值</div>
                      <code class="mt-1 block break-all font-mono text-[10px] text-muted">
                        {pkg.sha256}
                      </code>
                    </div>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Installation & Requirements -->
  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-xl font-bold text-ink-strong">安装与首次使用说明</h2>
          <div class="mt-5 space-y-4">
            <div class="rounded-xl border border-line bg-soft p-5">
              <h3 class="text-sm font-semibold text-ink-strong">1. 如何选择 macOS 安装包？</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">
                点击 Mac 左上角苹果菜单 →「关于本机」，若「芯片」显示 Apple M1 / M2 / M3 / M4，请选择 <strong>macOS Apple Silicon (arm64)</strong>；若「处理器」显示 Intel，请选择 <strong>macOS Intel (x64)</strong>。
              </p>
            </div>

            <div class="rounded-xl border border-line bg-soft p-5">
              <h3 class="text-sm font-semibold text-ink-strong">2. 需要联网吗？旧版本数据会保留吗？</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">
                登录认证、云端房源同步、AI 文案与语音合成需要联网；视频渲染与开场拼接在本机运行。覆盖安装新版时，原有的登录状态、本机平台账号与任务缓存会自动保留。
              </p>
            </div>

            <div class="rounded-xl border border-line bg-soft p-5">
              <h3 class="text-sm font-semibold text-ink-strong">3. 账号与积分如何开通？</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">
                桌面端需要使用已开通的账号登录。内测阶段由管理员在独立 Web 管理后台为您创建账号，并可通过积分兑换码或后台直接充值。详见 <a href="/docs/credits-billing" class="font-medium text-brand hover:underline">积分与计费说明</a>。
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-line bg-canvas/70 p-6">
            <h2 class="text-base font-bold text-ink-strong">推荐硬件与网络建议</h2>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex justify-between gap-4 border-b border-line pb-2.5">
                <dt class="text-muted">推荐内存</dt>
                <dd class="font-medium text-ink-strong">8 GB 及以上（推荐 16 GB）</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-line pb-2.5">
                <dt class="text-muted">可用磁盘空间</dt>
                <dd class="font-medium text-ink-strong">至少 4 GB（用于全景与成片缓存）</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-line pb-2.5">
                <dt class="text-muted">推荐屏幕分辨率</dt>
                <dd class="font-medium text-ink-strong">1440×900 或 1280×800 及以上</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-muted">开场视频规格</dt>
                <dd class="font-medium text-ink-strong">MP4 · 2–30 秒 · ≤ 50 MB</dd>
              </div>
            </dl>

            {
              showContact && (
                <div class="mt-6 border-t border-line pt-5 text-sm">
                  <div class="font-semibold text-ink-strong">需要协助或门店部署？</div>
                  <div class="mt-2 space-y-1 text-xs text-muted">
                    {siteConfig.contact.email && <div>邮箱：{siteConfig.contact.email}</div>}
                    {siteConfig.contact.wechatId && <div>微信：{siteConfig.contact.wechatId}</div>}
                    {siteConfig.contact.consultUrl && (
                      <a href={siteConfig.contact.consultUrl} target="_blank" rel="noreferrer" class="inline-block pt-1 font-medium text-brand hover:underline">
                        预约产品演示 →
                      </a>
                    )}
                  </div>
                </div>
              )
            }

            <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
              <a
                href="/changelog"
                class="inline-flex items-center rounded-lg border border-control bg-white px-3.5 py-2 text-xs font-semibold text-ink hover:border-brand/50 hover:text-brand"
              >
                查看 v{releaseDownloads.version} 更新日志
              </a>
              <a
                href="/docs"
                class="inline-flex items-center rounded-lg border border-control bg-white px-3.5 py-2 text-xs font-semibold text-ink hover:border-brand/50 hover:text-brand"
              >
                进入使用帮助
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
