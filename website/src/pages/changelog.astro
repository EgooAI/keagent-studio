---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("changelog")).sort((a, b) => b.data.order - a.data.order);
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    rendered: await render(entry),
  })),
);
---

<BaseLayout
  title="更新日志"
  description="记录 AI来客 桌面客户端、全景视频工作流、多平台发布与 AI 获客能力的版本迭代历程。"
>
  <section class="border-b border-line bg-arch-grid">
    <div class="bg-gradient-to-b from-white/60 via-white/85 to-white">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <span class="inline-flex rounded-full border border-brand-border bg-brand-soft px-3 py-1 text-xs font-medium text-brand">
          版本演进记录
        </span>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-ink-strong sm:text-4xl">
          更新日志
        </h1>
        <p class="mt-3 text-base leading-relaxed text-muted">
          持续记录 AI来客 桌面客户端、视频制作能力、平台分发与门店管理后台的每次重要更新。
        </p>
      </div>
    </div>
  </section>

  <section class="bg-canvas/45 py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {
          renderedEntries.map(({ entry, rendered: { Content } }) => (
            <article class="rounded-2xl border border-line bg-white p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-5">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="tabular-nums rounded-lg bg-brand px-3 py-1 text-sm font-bold text-white">
                    v{entry.data.version}
                  </span>
                  <span class="rounded-md bg-brand-soft px-2.5 py-1 text-xs font-semibold text-brand">
                    {entry.data.channel}
                  </span>
                  <span class="tabular-nums text-xs text-muted">{entry.data.date}</span>
                </div>
                <a
                  href="/download"
                  class="text-xs font-semibold text-brand hover:underline"
                >
                  查看客户端下载 →
                </a>
              </div>

              <h2 class="mt-5 text-xl font-bold text-ink-strong">{entry.data.title}</h2>

              {entry.data.highlights.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {entry.data.highlights.map((tag) => (
                    <span class="rounded-md border border-line bg-soft px-2.5 py-1 text-xs text-ink">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="doc-prose mt-5">
                <Content />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
