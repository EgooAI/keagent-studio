---
import "../styles/global.css";
import { siteConfig, hasContactConfigured } from "../config/site";
import { releaseDownloads } from "../config/downloads";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.subtitle}`;
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const showContact = hasContactConfigured();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink">
    <header class="sticky top-0 z-40 border-b border-line/90 bg-white/92 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5 text-ink-strong transition-opacity hover:opacity-90">
          <img
            src="/brand/logo.png"
            alt={siteConfig.name}
            width="32"
            height="32"
            class="h-8 w-8 rounded-lg border border-line/80 object-cover"
          />
          <div class="flex items-baseline gap-2">
            <span class="text-[17px] font-bold tracking-tight text-ink-strong">{siteConfig.name}</span>
            <span class="hidden text-xs font-medium text-muted sm:inline">{siteConfig.subtitle}</span>
          </div>
        </a>

        <nav aria-label="主导航" class="hidden items-center gap-1 md:flex">
          {
            siteConfig.nav.map((item) => {
              const active = isActive(item.href);
              return (
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors",
                    active
                      ? "bg-brand-soft text-brand"
                      : "text-muted hover:bg-canvas hover:text-ink-strong",
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href="/docs/getting-started"
            class="hidden rounded-lg border border-control bg-white px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:border-brand/50 hover:text-brand sm:inline-flex"
          >
            快速上手
          </a>
          <a
            href="/download"
            class="inline-flex items-center gap-1.5 rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-hover active:bg-brand-active"
          >
            <span>获取客户端</span>
          </a>
          <button
            type="button"
            id="mobile-menu-toggle"
            aria-label="打开导航菜单"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-control text-ink md:hidden"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-nav-drawer" class="hidden border-t border-line bg-white px-4 py-3 md:hidden">
        <nav aria-label="移动端导航" class="flex flex-col gap-1">
          {
            siteConfig.nav.map((item) => {
              const active = isActive(item.href);
              return (
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "rounded-lg px-3 py-2.5 text-sm font-medium",
                    active ? "bg-brand-soft text-brand" : "text-ink hover:bg-canvas",
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line bg-canvas">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-12">
          <div class="md:col-span-5">
            <a href="/" class="inline-flex items-center gap-2.5">
              <img
                src="/brand/logo.png"
                alt={siteConfig.name}
                width="28"
                height="28"
                class="h-7 w-7 rounded-md border border-line object-cover"
              />
              <span class="text-base font-bold text-ink-strong">{siteConfig.name}</span>
              <span class="rounded bg-brand-soft px-2 py-0.5 text-xs font-medium text-brand">
                v{releaseDownloads.version} {releaseDownloads.channel}
              </span>
            </a>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
              {siteConfig.tagline}。支持 Windows 与 macOS 桌面端，打通房源导入、批量出片、多平台分发与评论线索跟进。
            </p>
          </div>

          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
            <div>
              <h3 class="text-xs font-semibold tracking-wider text-ink-strong uppercase">产品</h3>
              <ul class="mt-3 space-y-2.5 text-sm text-muted">
                <li><a href="/#workflow" class="hover:text-brand">四步业务闭环</a></li>
                <li><a href="/#capabilities" class="hover:text-brand">核心能力</a></li>
                <li><a href="/#solutions" class="hover:text-brand">个人与门店方案</a></li>
                <li><a href="/#billing" class="hover:text-brand">积分与边界说明</a></li>
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold tracking-wider text-ink-strong uppercase">资源</h3>
              <ul class="mt-3 space-y-2.5 text-sm text-muted">
                <li><a href="/download" class="hover:text-brand">客户端下载</a></li>
                <li><a href="/docs" class="hover:text-brand">使用帮助中心</a></li>
                <li><a href="/docs/getting-started" class="hover:text-brand">快速上手指南</a></li>
                <li><a href="/changelog" class="hover:text-brand">版本更新日志</a></li>
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold tracking-wider text-ink-strong uppercase">常用文档</h3>
              <ul class="mt-3 space-y-2.5 text-sm text-muted">
                <li><a href="/docs/video-factory" class="hover:text-brand">AI 视频工厂</a></li>
                <li><a href="/docs/publishing-center" class="hover:text-brand">抖音与小红书发布</a></li>
                <li><a href="/docs/ai-leads" class="hover:text-brand">评论监控与获客</a></li>
                <li><a href="/docs/store-admin" class="hover:text-brand">门店与后台管理</a></li>
              </ul>
            </div>
          </div>
        </div>

        {
          showContact && (
            <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-line pt-6 text-sm text-muted">
              {siteConfig.contact.email && (
                <span>
                  联系邮箱：<a href={`mailto:${siteConfig.contact.email}`} class="text-ink hover:text-brand">{siteConfig.contact.email}</a>
                </span>
              )}
              {siteConfig.contact.wechatId && <span>微信咨询：{siteConfig.contact.wechatId}</span>}
              {siteConfig.contact.consultUrl && (
                <a href={siteConfig.contact.consultUrl} target="_blank" rel="noreferrer" class="font-medium text-brand hover:underline">
                  在线预约演示 →
                </a>
              )}
            </div>
          )
        }

        <div class="mt-8 flex flex-col gap-2 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>{siteConfig.name} · {siteConfig.subtitle}</span>
            {siteConfig.companyName && <span>{siteConfig.companyName}</span>}
          </div>
          {
            siteConfig.icpNumber && (
              <a href={siteConfig.icpUrl} target="_blank" rel="noreferrer" class="hover:text-ink">
                {siteConfig.icpNumber}
              </a>
            )
          }
        </div>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById("mobile-menu-toggle");
      const drawer = document.getElementById("mobile-nav-drawer");
      if (toggle && drawer) {
        toggle.addEventListener("click", () => {
          const isOpen = !drawer.classList.contains("hidden");
          drawer.classList.toggle("hidden", isOpen);
          toggle.setAttribute("aria-expanded", String(!isOpen));
        });
      }
    </script>
  </body>
</html>
