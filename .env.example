VITE_API_MODE=live
# Browser auth defaults to same-origin /api (Vite proxy in development).
VITE_AUTH_API_URL=
VITE_GO_API_URL=http://127.0.0.1:18081
DATABASE_URL=postgresql://keagent:replace-me@127.0.0.1:55432/keagent
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-another-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:18080
CONTROL_API_URL=http://127.0.0.1:18080
GO_API_URL=http://127.0.0.1:18081
JWT_ISSUER=http://127.0.0.1:18080
JWT_AUDIENCE=keagent-api
JWKS_URL=http://127.0.0.1:18080/api/auth/jwks
# Keep true while old clients use the signed /v1 gateway; set false in both services afterwards.
ALLOW_LEGACY_GATEWAY=true
TRUSTED_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-or-more-characters
# OpenAI-compatible endpoint; server only, never use a VITE_ prefix for secrets.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_ALLOWED_HOSTS=api.deepseek.com

# Cloud panorama providers (Go service only; never add VITE_).
VOLC_TTS_API_KEY=
# Enable only after opening Voice Clone 2.0 and post-paid custom voices in Volcengine.
# Uses VOLC_TTS_API_KEY; credentials stay server-side. Each user gets a separate voice.
VOLC_VOICE_CLONE_ENABLED=false
VOLC_VOICE_CLONE_RESOURCE_ID=seed-icl-2.0
# Photo avatar API: CVSubmitTask / CVGetResult, using each user's uploaded image.
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_TOS_BUCKET=
VOLC_TOS_REGION=cn-beijing
# Extra exact CDN hostnames only if your returned video uses another vendor CDN.
VOLC_VIDEO_ALLOWED_HOSTS=
# Empty uses PATH. Install both tools on the desktop device.
FFMPEG_PATH=
FFPROBE_PATH=
