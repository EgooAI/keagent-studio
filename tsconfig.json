{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@keagent/shared-types": ["./packages/shared-types/src/index.ts"],
      "@keagent/api-client": ["./packages/api-client/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests", "*.ts"]
}
