    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "桌面主要任务操作，纯蓝底白字且不带主色阴影。",
      "html": "<button class=\"ds-btn-primary\">创建视频任务</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 15px;border:1px solid var(--blue,#2563eb);border-radius:8px;background:var(--blue,#2563eb);color:#fff;font-family:\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:14px;font-weight:400;line-height:1.5714285714285714;box-shadow:none;cursor:pointer;transition:all .2s cubic-bezier(.645,.045,.355,1)}.ds-btn-primary:hover{background:#4f8af7;border-color:#4f8af7}.ds-btn-primary:active{background:#1647c4;border-color:#1647c4}.ds-btn-primary:focus-visible{outline:3px solid #8ab0ff;outline-offset:3px}"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-default",
      "description": "与主操作并列的常规白底操作。",
      "html": "<button class=\"ds-btn-default\">保存配置</button>",
      "css": ".ds-btn-default{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 15px;border:1px solid #dee4ed;border-radius:8px;background:#fff;color:var(--ink,#1b2b44);font-family:\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:14px;font-weight:400;line-height:1.5714285714285714;box-shadow:0 2px 0 rgba(0,0,0,.02);cursor:pointer;transition:all .2s cubic-bezier(.645,.045,.355,1)}.ds-btn-default:hover{color:#4f8af7;border-color:#4f8af7}.ds-btn-default:active{color:#1647c4;border-color:#1647c4}.ds-btn-default:focus-visible{outline:3px solid #8ab0ff;outline-offset:3px}"
    },
    {
      "name": "文本输入",
      "kind": "input",
      "refersTo": "input",
      "description": "继承桌面主题的标准单行字段。",
      "html": "<label class=\"ds-field\">房源名称<input class=\"ds-input\" placeholder=\"输入小区或房源号\" /></label>",
      "css": ".ds-field{display:grid;gap:10px;color:var(--ink,#1b2b44);font-family:\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;font-weight:550}.ds-input{height:38px;padding:7px 11px;border:1px solid #dee4ed;border-radius:8px;background:#fff;color:var(--ink,#1b2b44);font-family:\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:14px;line-height:1.5714285714285714;transition:all .2s;caret-color:var(--blue,#2563eb)}.ds-input:hover{border-color:#4f8af7}.ds-input:focus{border-color:var(--blue,#2563eb);box-shadow:0 0 0 2px rgba(5,122,255,.06);outline:0}.ds-input:focus-visible{outline:3px solid #8ab0ff;outline-offset:3px}.ds-input:disabled{color:rgba(0,0,0,.25);background:rgba(0,0,0,.04);cursor:not-allowed}"
