{
  "name": "keagent-studio",
  "private": true,
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:control": "node scripts/service.mjs control",
    "dev:cloud": "node scripts/service.mjs cloud",
    "setup:auth": "node scripts/service.mjs setup",
    "dev:backend": "concurrently -k \"pnpm dev:control\" \"pnpm dev:cloud\"",
    "dev:web": "pnpm --filter @keagent/desktop dev",
    "dev:desktop": "pnpm prepare:channels && pnpm build:publishing && node scripts/dev-desktop.mjs",
    "dev:admin": "pnpm --filter @keagent/admin dev",
    "build": "pnpm build:publishing && pnpm --filter @keagent/desktop build && pnpm --filter @keagent/admin build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && prettier --check \"apps/**/*.{ts,tsx,css,cjs,html}\" \"packages/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\" \"*.{json,ts}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare:channels": "node scripts/provision-channels-worker.mjs && node scripts/provision-channels-browser.mjs",
    "prepare:desktop-package": "pnpm prepare:channels && pnpm build:publishing && pnpm --filter @keagent/desktop build && node scripts/build-desktop-updater.mjs && node scripts/prepare-desktop-package.mjs",
    "package:desktop": "pnpm prepare:desktop-package && electron-builder --dir",
    "package:desktop:installer": "node scripts/provision-desktop-media.mjs && pnpm prepare:desktop-package --installer && electron-builder --config scripts/desktop-installer.cjs --publish never",
    "preview": "pnpm --filter @keagent/desktop preview",
    "build:publishing": "pnpm build:artifact-media && vite build --config publishing.vite.config.ts",
    "build:artifact-media": "vite build --config artifact-media.vite.config.ts"
  },
  "build": {
    "appId": "com.keagent.studio",
    "productName": "AI来客",
    "artifactName": "AI-Laike-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "app": "output/desktop-app"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "apps/desktop/electron/**/*",
      "!apps/desktop/electron/**/*.test.ts",
      "desktop-release.json",
      "package.json",
      "!apps/desktop/electron/publishing/**/*.ts",
      "apps/desktop/electron/publishing/dist/runtime.cjs"
    ],
    "extraResources": [
      {
        "from": "output/channels-browser",
        "to": "channels-browser"
      },
      {
        "from": "output/channels-runtime",
        "to": "channels-runtime"
      },
      {
        "from": "output/desktop-app/media-tools",
        "to": "media-tools"
      }
    ],
    "extraMetadata": {
      "main": "apps/desktop/electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "mac": {
      "signIgnore": "/channels-browser/Chromium\\.app(?:/|$)",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "beforeBuild": "scripts/desktop-before-build.cjs"
  },
  "dependencies": {
    "@app/auth-sdk": "file:vendor/auth-sdk.tgz",
    "@tanstack/react-query": "^5.105.0",
    "antd": "^6.6.8",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.65.0",
    "next": "16.3.4",
    "pg": "8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.14",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
