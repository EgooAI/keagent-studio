# Install as /etc/keagent/keagent.env, owned by root with mode 0600.
DATABASE_URL=postgresql://keagent:replace-me@127.0.0.1:15432/keagent_staging
# Generate a random value with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://admin.example.com
JWT_ISSUER=https://admin.example.com
JWT_AUDIENCE=keagent-api
JWKS_URL=http://127.0.0.1:18180/api/auth/jwks
TRUSTED_ORIGINS=https://admin.example.com
ALLOW_LEGACY_GATEWAY=false

# For AI configuration edits in admin, generate once with: openssl rand -base64 32
# Keep the same value across releases and retain a secure copy for recovery.
AI_CONFIG_ENCRYPTION_KEY=
