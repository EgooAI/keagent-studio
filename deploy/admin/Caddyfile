admin.example.com {
	@control path /api /api/*
	handle @control {
		reverse_proxy 127.0.0.1:18180
	}

	@installerFeeds path /desktop-updates/win32-x64/* /desktop-updates/darwin-arm64/*
	redir @installerFeeds https://update.laike.zhaihealth.com{uri} 302

	handle_path /desktop-updates/* {
		root * /opt/keagent/desktop-updates
		@manifest path *.yml /config-v1.json
		header @manifest Cache-Control "no-cache"
		file_server
	}

	@cloud path /v1 /v1/* /health
	handle @cloud {
		reverse_proxy 127.0.0.1:18181
	}

	handle {
		root * /opt/keagent/current/apps/admin/dist
		file_server
	}
}
